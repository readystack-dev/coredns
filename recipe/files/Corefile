# The image's default configuration (CMD -conf /etc/coredns/Corefile). Without a Corefile CoreDNS serves upstream's own
# default, `whoami` on :53; this keeps that and adds the health (:8080) and ready (:8181) endpoints kubeadm's CoreDNS
# Deployment probes, so the image's HEALTHCHECK has something to ask. kubeadm mounts its own Corefile over /etc/coredns.
.:53 {
    errors
    health :8080
    ready :8181
    whoami
    log
}
